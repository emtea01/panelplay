[Unit]
Description=PanelPlay - 2000 AD story arcs as narrated Plex episodes
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/plex

[Service]
Type=simple
User=panelplay
Group=panelplay
WorkingDirectory=/opt/panelplay
Environment=PANELPLAY_HOST=0.0.0.0
Environment=PANELPLAY_PORT=8077
Environment=PANELPLAY_DATA=/var/lib/panelplay
Environment=HOME=/var/lib/panelplay
Environment=HF_HOME=/var/lib/panelplay/huggingface
Environment=PYTHONIOENCODING=utf-8
EnvironmentFile=-/etc/panelplay.env
ExecStart=/opt/panelplay/venv/bin/python -m portal
Restart=on-failure
RestartSec=5

# The code and comics stay read-only; only the data folder and the Plex folder are writable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/panelplay /mnt/plex

[Install]
WantedBy=multi-user.target
