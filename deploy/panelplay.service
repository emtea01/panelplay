[Unit]
Description=PanelPlay - 2000 AD story arcs as narrated Plex episodes
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
Type=simple
User=panelplay
Group=panelplay
WorkingDirectory=/opt/panelplay
Environment=PANELPLAY_HOST=0.0.0.0
Environment=PANELPLAY_PORT=8077
Environment=PANELPLAY_DATA=/var/lib/panelplay
Environment=HOME=/var/lib/panelplay
Environment=HF_HOME=/var/lib/panelplay/huggingface
Environment=PYTHONIOENCODING=utf-8
EnvironmentFile=-/etc/panelplay.env
ExecStart=/opt/panelplay/venv/bin/python -m portal
Restart=on-failure
RestartSec=5

# /usr, /boot and /etc are read-only. The comics and Plex folders can be mounted anywhere else,
# so the rest is left to ordinary file permissions.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
